---
import { absoluteUrl, siteConfig } from '@/config/site';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}

const {
  title,
  description = siteConfig.defaultDescription,
  canonical,
  ogImage = siteConfig.defaultOgImage,
  ogType = 'website',
  jsonLd,
  noindex = false,
} = Astro.props;

const canonicalUrl = canonical ?? absoluteUrl(Astro.url.pathname);
const imageUrl = ogImage.startsWith('http') ? ogImage : absoluteUrl(ogImage);
const robotsContent = siteConfig.indexing.enabled && !noindex ? 'index, follow' : 'noindex, nofollow';
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={robotsContent} />
{robotsContent !== 'index, follow' && <meta name="googlebot" content="noindex, nofollow, noarchive, nosnippet" />}
<link rel="canonical" href={canonicalUrl} />

<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={siteConfig.name} />
<meta property="og:locale" content="it_IT" />
<meta property="og:image" content={imageUrl} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />

{
  jsonLd && (
    Array.isArray(jsonLd)
      ? jsonLd.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)
      : <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  )
}
