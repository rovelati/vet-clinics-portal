---
interface Props {
  query?: string;
  location?: string;
}

const { query = '', location = '' } = Astro.props;

---

<form action="/cerca-veterinari" method="get" class="overflow-hidden rounded-lg border border-white/10 bg-white shadow-2xl shadow-black/25">
  <div class="flex flex-col sm:flex-row">
    <div class="flex-1 border-b border-gray-200 sm:border-b-0 sm:border-r">
      <label for="query" class="block px-4 pt-3 text-xs font-bold uppercase tracking-wide text-gray-600">Cosa cerchi?</label>
      <input
        id="query"
        name="query"
        type="search"
        value={query}
        autocomplete="off"
        placeholder="Es. ecografia, sterilizzazione..."
        class="h-11 w-full border-0 px-4 pb-2 text-base font-semibold text-gray-950 outline-none placeholder:text-gray-500 focus:ring-0 sm:h-12 sm:text-lg"
      />
    </div>

    <div class="relative border-b border-gray-200 sm:w-72 sm:border-b-0 sm:border-r">
      <label for="location" class="block px-4 pl-11 pt-3 text-xs font-bold uppercase tracking-wide text-gray-600">Dove?</label>
      <span class="pointer-events-none absolute left-4 top-[2.35rem] -translate-y-1/2 text-gray-500">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M12 21s7-4.5 7-11a7 7 0 1 0-14 0c0 6.5 7 11 7 11Z"></path>
          <circle cx="12" cy="10" r="2.5"></circle>
        </svg>
      </span>
      <input
        id="location"
        name="location"
        type="search"
        value={location}
        placeholder="Es. Roma"
        class="h-11 w-full border-0 px-4 pb-2 pl-11 text-base font-semibold text-gray-950 outline-none placeholder:text-gray-500 focus:ring-0 sm:h-12 sm:text-lg"
      />
    </div>

    <button type="submit" class="flex h-14 items-center justify-center bg-green-600 px-6 text-base font-bold text-white transition-colors hover:bg-green-700 sm:h-auto">
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="11" cy="11" r="7"></circle>
        <path d="m20 20-3.5-3.5"></path>
      </svg>
      <span class="ml-2">Cerca</span>
    </button>
  </div>
</form>
