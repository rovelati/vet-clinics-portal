---
import { siteConfig } from '@/config/site';

const year = new Date().getFullYear();
const usefulLinks = [
  { href: '/', label: 'Home' },
  { href: '/veterinari-h24', label: 'Veterinari H24' },
  { href: '/quanto-costa', label: 'Quanto Costa?' },
  { href: '/integratori', label: 'Integratori' },
  { href: '/blog', label: 'Blog' },
  { href: '/chi-siamo', label: 'Chi Siamo' },
  { href: '/contatti', label: 'Contattaci' },
];
const legalLinks = [
  { href: '/privacy-policy', label: 'Privacy Policy' },
  { href: '/cookie-policy', label: 'Cookie Policy' },
  { href: '/note-legali', label: 'Note Legali' },
  { href: '/credits', label: 'Credits' },
];
---

<footer class="mt-auto bg-gray-900 text-gray-300">
  <div class="mx-auto grid max-w-7xl gap-8 px-4 py-12 sm:px-6 md:grid-cols-2 lg:grid-cols-4 lg:px-8">
    <section>
      <h2 class="mb-4 text-base font-semibold text-white">Contatti</h2>
      <p class="text-sm leading-relaxed text-gray-300">
        {siteConfig.name} raccoglie e organizza dati pubblici sulle cliniche veterinarie italiane per facilitare la ricerca di servizi, prezzi e disponibilita. I titolari possono richiedere aggiornamenti o correzioni scrivendo alla redazione.
      </p>
      <p class="mt-4 text-sm font-medium text-white">Redazione digitale - Italia</p>
      <a class="mt-2 inline-flex items-center gap-2 text-sm text-green-400 transition-colors hover:text-green-300" href={`mailto:${siteConfig.publicEmail}`}>
        {siteConfig.publicEmail}
      </a>
      <a class="mt-3 block text-sm text-green-400 underline transition-colors hover:text-green-300" href={`mailto:${siteConfig.publicEmail}?subject=Richiesta aggiornamento scheda clinica`}>
        Richiedi aggiornamento scheda clinica
      </a>
      <p class="mt-3 text-xs leading-5 text-gray-400">
        Al momento non e disponibile assistenza telefonica: contattaci via email per collaborazioni e segnalazioni.
      </p>
    </section>

    <section>
      <h2 class="mb-4 text-base font-semibold text-white">Link Utili</h2>
      <ul class="space-y-2 text-sm">
        {usefulLinks.map((link) => (
          <li><a href={link.href} class="transition-colors hover:text-white">{link.label}</a></li>
        ))}
      </ul>
    </section>

    <section>
      <h2 class="mb-4 text-base font-semibold text-white">Link Legali</h2>
      <ul class="space-y-2 text-sm">
        {legalLinks.map((link) => (
          <li><a href={link.href} class="transition-colors hover:text-white">{link.label}</a></li>
        ))}
      </ul>
    </section>

    <section>
      <h2 class="mb-4 text-base font-semibold text-white">{siteConfig.name}</h2>
      <p class="text-sm leading-relaxed text-gray-300">
        Portale indipendente per trovare cliniche veterinarie, servizi H24, prestazioni, prezzi indicativi e schede aggiornabili dai titolari.
      </p>
      <a href="/claim" class="mt-4 inline-flex rounded-md border border-gray-700 px-3 py-2 text-sm font-semibold text-gray-200 transition-colors hover:border-green-400 hover:text-white">
        Aggiorna gratis la scheda
      </a>
    </section>
  </div>

  <div class="border-t border-gray-800 px-4 py-5">
    <div class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-4 text-sm text-gray-400 md:flex-row">
      <p>(c) {year} {siteConfig.legalName}. Tutti i diritti riservati.</p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <button type="button" class="transition-colors hover:text-white" onclick="if (window.__unicapi) window.__unicapi('openunic');">
          Impostazioni Consenso
        </button>
        {legalLinks.map((link) => (
          <a href={link.href} class="transition-colors hover:text-white">{link.label}</a>
        ))}
      </div>
    </div>
  </div>
</footer>
