---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { siteConfig } from '@/config/site';
import { CalendarDays, Camera, FileText, Heart, HeartPulse, LockKeyhole, PawPrint, Share2, ShieldCheck, Stethoscope } from 'lucide-react';

const title = `Pet Lover | Libretto digitale gratuito per il tuo animale | ${siteConfig.name}`;
const description = `Crea il profilo del tuo animale, salva scadenze sanitarie e condividi i dati con il veterinario quando chiedi una visita o un preventivo.`;
const heroImage = 'https://images.unsplash.com/photo-1712746438800-1062143fe1ad?auto=format&fit=crop&w=900&q=82';

const serviceCards = [
  {
    icon: PawPrint,
    title: 'Scheda animale completa',
    text: 'Nome, specie, razza, sesso, data di nascita, peso, microchip, sterilizzazione e note utili per la visita.',
  },
  {
    icon: Camera,
    title: 'Foto e riconoscimento',
    text: 'Carichi una foto con preview immediata, cosi la scheda e riconoscibile anche quando condivisa.',
  },
  {
    icon: HeartPulse,
    title: 'Dati sanitari ordinati',
    text: 'Allergie, patologie, farmaci, alimentazione e comportamento in un unico posto, sempre aggiornabile.',
  },
  {
    icon: CalendarDays,
    title: 'Vaccini e promemoria',
    text: 'Tieni sotto controllo scadenze per vaccini, antiparassitari, farmaci e controlli periodici.',
  },
  {
    icon: FileText,
    title: 'Spese veterinarie',
    text: 'Archivio annuale di spese, fatture e documenti utile per 730, assicurazioni e rimborsi.',
  },
  {
    icon: Share2,
    title: 'Condivisione sicura',
    text: 'Invii al veterinario un link privato e revocabile con la scheda dell animale quando serve.',
  },
];

const steps = [
  ['Registrati gratis', 'Crei il tuo account Pet Lover in pochi passaggi.'],
  ['Aggiungi uno o piu animali', 'Compili i dati essenziali e carichi la foto.'],
  ['Usa la zampa digitale', 'Gestisci scadenze, spese e condivisioni dalla tua area clienti.'],
];
---

<BaseLayout title={title} description={description} canonical={`${siteConfig.url}/pet-lover`}>
  <main class="bg-slate-50">
    <section class="mx-auto grid max-w-7xl items-center gap-10 px-4 py-10 sm:px-6 lg:min-h-[680px] lg:grid-cols-[minmax(0,1fr)_460px] lg:px-8 lg:py-16">
      <div class="flex flex-col">
        <div class="inline-flex w-fit items-center gap-2 rounded-full border border-emerald-200 bg-white px-3 py-1 text-sm font-semibold text-emerald-700">
          <PawPrint className="h-4 w-4" aria-hidden="true" />
          Area Pet <Heart className="h-4 w-4 fill-red-500 text-red-500" aria-hidden="true" /> Lover
        </div>
        <h1 class="mt-5 max-w-4xl text-4xl font-bold leading-tight text-slate-950 sm:text-5xl lg:text-6xl">
          La zampa digitale per prenderti cura di chi ami
        </h1>
        <p class="mt-5 max-w-2xl text-xl leading-9 text-slate-600">
          Ogni animale ha una storia: foto, dati sanitari, vaccini, spese e veterinari di fiducia. Con Veterinari.org la tieni ordinata e la condividi solo quando serve.
        </p>
        <div class="mt-7 flex flex-col gap-3 sm:flex-row">
          <a href="/register?type=proprietario&redirect=/dashboard/pet-lover" rel="nofollow" class="inline-flex h-12 items-center justify-center rounded-md bg-emerald-600 px-5 text-base font-semibold text-white shadow-sm hover:bg-emerald-700">
            Crea il profilo del tuo animale
          </a>
          <a href="/login?redirect=/dashboard/pet-lover" rel="nofollow" class="inline-flex h-12 items-center justify-center rounded-md border border-slate-300 bg-white px-5 text-base font-semibold text-slate-800 hover:bg-slate-100">
            Accedi
          </a>
        </div>
        <p class="mt-3 text-sm leading-6 text-slate-500">Gratis, privato, pensato per chi vive davvero con un animale.</p>
      </div>

      <div class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm lg:justify-self-end">
        <div class="overflow-hidden rounded-md border border-slate-100 bg-slate-50">
          <div class="relative h-72 overflow-hidden bg-emerald-100 sm:h-80 lg:h-[360px]">
            <img
              src={heroImage}
              alt="Proprietaria sorridente sul divano con il suo cane"
              class="h-full w-full object-cover"
              loading="eager"
              decoding="async"
            />
          </div>
          <div class="bg-white p-5 pt-0">
            <div class="-mt-10 grid h-20 w-20 place-items-center rounded-full border-4 border-white bg-emerald-100 text-3xl shadow-sm">🐾</div>
            <div class="mt-4 rounded-md border border-emerald-100 bg-emerald-50 p-4">
              <p class="inline-flex items-center gap-1 text-sm font-semibold text-emerald-700">
                Pet <Heart className="h-4 w-4 fill-red-500 text-red-500" aria-hidden="true" /> Lover
              </p>
              <p class="mt-1 text-xl font-bold leading-snug text-slate-950">Tutto ciò che serve al veterinario, già pronto.</p>
            </div>
            <div class="mt-4 flex items-start justify-between gap-3">
              <div>
                <p class="text-2xl font-bold text-slate-950">Luna</p>
                <p class="text-sm text-slate-500">Cane, 4 anni, microchip salvato</p>
              </div>
              <span class="rounded-full bg-emerald-100 px-3 py-1 text-xs font-semibold text-emerald-700">Privato</span>
            </div>
            <div class="mt-5 grid gap-2">
              <div class="flex items-center justify-between rounded-md border border-slate-100 bg-slate-50 px-3 py-2 text-sm">
                <span class="font-medium text-slate-700">Vaccino annuale</span>
                <span class="text-emerald-700">12 ago</span>
              </div>
              <div class="flex items-center justify-between rounded-md border border-slate-100 bg-slate-50 px-3 py-2 text-sm">
                <span class="font-medium text-slate-700">Antiparassitario</span>
                <span class="text-amber-700">tra 7 giorni</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="border-y border-slate-200 bg-white">
      <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
        <div class="max-w-3xl">
          <p class="text-sm font-semibold uppercase text-emerald-700">Servizi inclusi</p>
          <h2 class="mt-2 text-3xl font-bold text-slate-950">La tua area clienti per gestire la salute del tuo animale</h2>
          <p class="mt-3 text-lg leading-8 text-slate-600">
            L Area Pet Lover nasce per arrivare preparati dal veterinario: dati dell animale, storia sanitaria, scadenze e documenti condivisibili quando servono.
          </p>
        </div>
        <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {serviceCards.map((item) => (
          <a href="/register?type=proprietario&redirect=/dashboard/pet-lover" rel="nofollow" class="rounded-lg border border-slate-200 bg-white p-5 transition hover:border-emerald-300 hover:bg-emerald-50">
            <item.icon className="h-6 w-6 text-emerald-600" aria-hidden="true" />
            <h2 class="mt-3 font-semibold text-slate-950">{item.title}</h2>
            <p class="mt-2 text-sm leading-6 text-slate-600">{item.text}</p>
          </a>
        ))}
        </div>
      </div>
    </section>

    <section class="bg-slate-50 py-12">
      <div class="mx-auto grid max-w-7xl gap-8 px-4 sm:px-6 lg:grid-cols-[0.9fr_1.1fr] lg:px-8">
        <div>
          <p class="text-sm font-semibold uppercase text-emerald-700">Come funziona</p>
          <h2 class="mt-2 text-3xl font-bold text-slate-950">Dalla registrazione alla condivisione col veterinario</h2>
          <p class="mt-3 text-lg leading-8 text-slate-600">
            Il flusso e pensato mobile first: apri la dashboard, aggiungi l animale e usi la scheda quando chiedi informazioni, una visita o un preventivo.
          </p>
          <a href="/register?type=proprietario&redirect=/dashboard/pet-lover" rel="nofollow" class="mt-6 inline-flex h-12 items-center justify-center rounded-md bg-emerald-600 px-5 text-base font-semibold text-white shadow-sm hover:bg-emerald-700">
            Crea la tua zampa digitale
          </a>
        </div>
        <div class="grid gap-3">
          {steps.map(([title, text], index) => (
            <div class="flex gap-4 rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
              <div class="grid h-9 w-9 shrink-0 place-items-center rounded-md bg-emerald-100 text-sm font-bold text-emerald-700">{index + 1}</div>
              <div>
                <h3 class="font-semibold text-slate-950">{title}</h3>
                <p class="mt-1 text-sm leading-6 text-slate-600">{text}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-white py-12">
      <div class="mx-auto grid max-w-7xl gap-6 px-4 sm:px-6 lg:grid-cols-3 lg:px-8">
        <div class="rounded-lg border border-slate-200 p-5">
          <Stethoscope className="h-6 w-6 text-emerald-600" aria-hidden="true" />
          <h2 class="mt-3 font-semibold text-slate-950">Quando contatti una clinica</h2>
          <p class="mt-2 text-sm leading-6 text-slate-600">
            Puoi allegare la scheda del tuo animale alla richiesta, cosi il veterinario vede subito dati utili, condizioni e note sanitarie.
          </p>
        </div>
        <div class="rounded-lg border border-slate-200 p-5">
          <LockKeyhole className="h-6 w-6 text-emerald-600" aria-hidden="true" />
          <h2 class="mt-3 font-semibold text-slate-950">Controllo dei dati</h2>
          <p class="mt-2 text-sm leading-6 text-slate-600">
            I link durano 14 giorni e possono essere revocati. Codice fiscale e dati sensibili restano opzionali.
          </p>
        </div>
        <div class="rounded-lg border border-slate-200 p-5">
          <FileText className="h-6 w-6 text-emerald-600" aria-hidden="true" />
          <h2 class="mt-3 font-semibold text-slate-950">Documenti e rimborsi</h2>
          <p class="mt-2 text-sm leading-6 text-slate-600">
            Conservi le spese veterinarie per anno, utile quando devi recuperare dati per 730, assicurazione o note amministrative.
          </p>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
      <div class="rounded-lg border border-emerald-200 bg-emerald-50 p-5 sm:flex sm:items-center sm:justify-between sm:gap-6">
        <div class="flex gap-3">
          <ShieldCheck className="mt-1 h-6 w-6 shrink-0 text-emerald-700" aria-hidden="true" />
          <div>
            <h2 class="font-semibold text-emerald-950">Privacy by design</h2>
            <p class="mt-1 text-sm leading-6 text-emerald-900">Codice fiscale e dati sanitari sono opzionali. Puoi aggiungerli solo quando servono per fatture, rimborsi o condivisione col veterinario.</p>
          </div>
        </div>
        <a href="/register?type=proprietario&redirect=/dashboard/pet-lover" rel="nofollow" class="mt-5 inline-flex h-11 w-full items-center justify-center rounded-md bg-emerald-700 px-4 text-sm font-semibold text-white hover:bg-emerald-800 sm:mt-0 sm:w-auto">
          Inizia gratis
        </a>
      </div>
    </section>
  </main>
</BaseLayout>
