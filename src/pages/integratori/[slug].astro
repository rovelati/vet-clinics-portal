---
import { ArrowLeft, CheckCircle, AlertTriangle } from 'lucide-react';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { absoluteUrl, siteConfig } from '@/config/site';
import { getIntegratoreDetail } from '@/lib/integratori';

const slug = Astro.params.slug;
const data = getIntegratoreDetail(slug);

if (!data) {
  return Astro.redirect('/integratori');
}

const canonical = absoluteUrl(`/integratori/${slug}`);
const title = `${data.name} | ${siteConfig.name}`;
const description = data.intro;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: data.name,
  description: data.intro,
  url: canonical,
  publisher: {
    '@type': 'Organization',
    name: siteConfig.name,
    url: siteConfig.url,
  },
  mainEntityOfPage: canonical,
};
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogType="article"
  jsonLd={jsonLd}
>
  <div class="bg-white">
    <main class="mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:px-8">
      <div class="space-y-8">
        <a href="/integratori" class="inline-flex items-center font-medium text-purple-600 hover:text-purple-800">
          <ArrowLeft className="mr-2 h-4 w-4" aria-hidden="true" />
          Torna alla guida integratori
        </a>

        <header class="text-center">
          <div class="mb-4 text-5xl" aria-hidden="true">{data.icon}</div>
          <h1 class="mb-4 text-3xl font-bold text-gray-900 md:text-4xl">{data.name}</h1>
          <p class="mx-auto max-w-3xl text-lg text-gray-600">{data.intro}</p>
        </header>

        <div class="space-y-5 text-lg leading-relaxed text-gray-700">
          {data.description.map((paragraph) => <p>{paragraph}</p>)}
        </div>

        <section class="rounded-lg bg-purple-50 p-6 shadow-lg">
          <h2 class="mb-4 text-2xl font-bold text-gray-900">Benefici principali</h2>
          <ul class="space-y-3">
            {data.features.map((feature) => (
              <li class="flex items-start">
                <CheckCircle className="mr-3 mt-0.5 h-6 w-6 shrink-0 text-green-500" aria-hidden="true" />
                <span class="text-gray-700">{feature}</span>
              </li>
            ))}
          </ul>
        </section>

        <section class="rounded-lg border border-purple-200 bg-white p-6">
          <h2 class="mb-2 text-xl font-bold text-gray-900">Quando e consigliato?</h2>
          <p class="text-gray-700">{data.whenToUse}</p>
        </section>

        <section class="flex items-start gap-4 rounded-lg border border-amber-200 bg-amber-50 p-6">
          <AlertTriangle className="mt-0.5 h-6 w-6 shrink-0 text-amber-600" aria-hidden="true" />
          <div>
            <h2 class="mb-1 font-bold text-amber-800">Avvertenza importante</h2>
            <p class="text-sm text-amber-700">
              Le informazioni presenti in questa pagina hanno scopo puramente informativo e non sostituiscono il parere del veterinario.
              Consulta sempre un professionista prima di somministrare integratori al tuo animale domestico.
              Il dosaggio e la durata del trattamento dipendono da specie, peso, eta e condizioni di salute dell'animale.
            </p>
          </div>
        </section>

        <div class="pt-4 text-center">
          <a href="/cerca-veterinari" class="inline-flex h-12 items-center justify-center rounded-md bg-purple-600 px-6 font-semibold text-white hover:bg-purple-700">
            Chiedi consiglio a un veterinario
          </a>
        </div>
      </div>
    </main>
  </div>
</BaseLayout>
