              <h2 class="mt-1 text-xl font-bold text-gray-950">Salva questo veterinario nella tua area</h2>
            </div>
            <button type="button" data-favorite-modal-close class="rounded-md border border-gray-300 px-3 py-2 text-sm font-semibold text-gray-700">Chiudi</button>
          </div>
          <p class="mt-4 text-sm leading-6 text-gray-600">
            Registrati gratis per creare la zampa digitale del tuo animale, ritrovare i veterinari utili e condividere i dati sanitari quando serve.
          </p>
          <div class="mt-5 grid gap-2 sm:grid-cols-2">
            <a href={petLoverRegisterUrl} rel="nofollow" class="inline-flex justify-center rounded-md bg-green-600 px-4 py-3 text-sm font-bold text-white hover:bg-green-700">Registrati gratis</a>
            <a href={petLoverLoginUrl} rel="nofollow" class="inline-flex justify-center rounded-md border border-gray-300 px-4 py-3 text-sm font-bold text-gray-800 hover:bg-gray-50">Accedi</a>
          </div>
        </div>
      </div>
    </div>

    {(clinic.phone || clinic.email || hasPosition) && (
      <div class="vet-mobile-contact-bar md:hidden" role="navigation" aria-label="Contatti rapidi">
        <div class="mx-auto flex max-w-md gap-2 px-3 py-2">
          {clinic.phone && (
            <a href={`tel:${normalizePhone(clinic.phone)}`} data-clinic-id={String(clinic.id)} class={`inline-flex min-w-0 flex-1 items-center justify-center rounded-md px-3 py-3 text-sm font-bold shadow-sm ${callButtonClass}`}>
              <Phone className="mr-2 h-5 w-5 shrink-0" aria-hidden="true" />
              Chiama
            </a>
          )}
          {clinic.email && (
            <button type="button" data-clinic-quote-open class="inline-flex min-w-0 flex-1 items-center justify-center rounded-md bg-emerald-600 px-3 py-3 text-sm font-bold text-white shadow-sm">
              <DollarSign className="mr-1.5 h-5 w-5 shrink-0" aria-hidden="true" />
              Preventivo
            </button>
          )}
          {hasPosition && (
            <a href={googleDirections} data-clinic-id={String(clinic.id)} target="_blank" rel="noopener noreferrer" class="inline-flex min-w-0 flex-1 items-center justify-center rounded-md bg-gray-900 px-3 py-3 text-sm font-bold text-white shadow-sm">
              <Navigation className="mr-2 h-5 w-5 shrink-0" aria-hidden="true" />
              Percorso
            </a>
          )}
        </div>
      </div>
    )}
  </div>
</BaseLayout>

<script>
  const contactModal = document.getElementById('contact-modal');
  const contactForm = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const contactFeedback = document.querySelector<HTMLElement>('[data-contact-feedback]');
  const contactPetPanel = document.querySelector<HTMLElement>('[data-contact-pet-panel]');
  const contactPetSelect = document.querySelector<HTMLSelectElement>('#contact-pet-id');
  const favoriteButton = document.querySelector<HTMLButtonElement>('[data-favorite-clinic]');
  const favoriteLabel = favoriteButton?.querySelector<HTMLElement>('[data-favorite-label]');
  const favoriteFeedback = document.querySelector<HTMLElement>('[data-favorite-feedback]');
  const favoriteLoginModal = document.getElementById('favorite-login-modal');
  const clinicQuoteModal = document.getElementById('clinic-quote-modal');
  const clinicQuoteForm = document.querySelector<HTMLFormElement>('[data-clinic-quote-form]');
  const clinicQuoteFeedback = document.querySelector<HTMLElement>('[data-clinic-quote-feedback]');
  const clinicQuoteServiceSelect = document.querySelector<HTMLSelectElement>('#clinic-quote-service');
  const clinicQuoteMessage = document.querySelector<HTMLTextAreaElement>('#clinic-quote-message');

  const selectedClinicQuoteService = () => {
    const option = clinicQuoteServiceSelect?.selectedOptions?.[0];
    return {
      slug: clinicQuoteServiceSelect?.value || '',
      name: option?.getAttribute('data-service-name') || option?.textContent?.replace(/\s+·\s+dichiarata\s*$/i, '').trim() || 'Visita semplice',
      averagePrice: option?.getAttribute('data-average-price') || '',
      source: option?.getAttribute('data-source') || 'standard',
    };
  };

  const clinicQuoteDefaultMessage = (serviceName: string) => {
    const clinicName = clinicQuoteForm?.getAttribute('data-clinic-name') || 'la struttura';
    const locationLabel = clinicQuoteForm?.getAttribute('data-location-label') || '';
    return [
      `Vorrei chiedere un preventivo per ${serviceName}${locationLabel ? ` presso ${clinicName} a ${locationLabel}` : ` presso ${clinicName}`}.`,
      'Potete indicarmi disponibilita, prezzo indicativo e tempi?',
      '',
      'Grazie',
    ].join('\n');
  };

  const updateClinicQuoteMessage = () => {
    if (!clinicQuoteMessage) return;
    const service = selectedClinicQuoteService();
    clinicQuoteMessage.value = clinicQuoteDefaultMessage(service.name);
  };

  const setFavoriteUi = (favorited: boolean) => {
    if (!favoriteButton || !favoriteLabel) return;
    favoriteButton.setAttribute('aria-pressed', String(favorited));
    favoriteButton.classList.toggle('border-rose-600', favorited);
    favoriteButton.classList.toggle('bg-rose-600', favorited);
    favoriteButton.classList.toggle('text-white', favorited);
    favoriteButton.classList.toggle('border-rose-200', !favorited);
    favoriteButton.classList.toggle('bg-white', !favorited);
    favoriteButton.classList.toggle('text-rose-700', !favorited);
    favoriteLabel.textContent = favorited ? 'Salvato nei preferiti' : 'Salva tra i preferiti';
  };

  const showFavoriteFeedback = (message: string) => {
    if (!favoriteFeedback) return;
    favoriteFeedback.textContent = message;
    favoriteFeedback.classList.remove('hidden');
    window.setTimeout(() => favoriteFeedback.classList.add('hidden'), 3500);
  };

  const openFavoriteLoginModal = () => {
    if (!favoriteLoginModal) return;
    favoriteLoginModal.classList.remove('hidden');
    favoriteLoginModal.setAttribute('aria-hidden', 'false');
    document.body.classList.add('overflow-hidden');
  };

  const closeFavoriteLoginModal = () => {
    if (!favoriteLoginModal) return;
    favoriteLoginModal.classList.add('hidden');
    favoriteLoginModal.setAttribute('aria-hidden', 'true');
    document.body.classList.remove('overflow-hidden');
  };

  const showContactFeedback = (message: string, type: 'success' | 'error' = 'success') => {
    if (!contactFeedback) return;
    contactFeedback.textContent = message;
    contactFeedback.classList.remove('hidden', 'bg-green-50', 'text-green-800', 'bg-red-50', 'text-red-800');
    contactFeedback.classList.add(type === 'success' ? 'bg-green-50' : 'bg-red-50', type === 'success' ? 'text-green-800' : 'text-red-800');
  };

  const showClinicQuoteFeedback = (message: string, type: 'success' | 'error' = 'success') => {
    if (!clinicQuoteFeedback) return;
    clinicQuoteFeedback.textContent = message;
    clinicQuoteFeedback.classList.remove('hidden', 'bg-green-50', 'text-green-800', 'bg-red-50', 'text-red-800');
    clinicQuoteFeedback.classList.add(type === 'success' ? 'bg-green-50' : 'bg-red-50', type === 'success' ? 'text-green-800' : 'text-red-800');
  };

  const openContactModal = () => {
    if (!contactModal) return;
    contactModal.classList.remove('hidden');
    contactModal.setAttribute('aria-hidden', 'false');
    document.body.classList.add('overflow-hidden');
    contactForm?.querySelector<HTMLInputElement>('input[name="name"]')?.focus();
  };

  const closeContactModal = () => {
    if (!contactModal) return;
    contactModal.classList.add('hidden');
    contactModal.setAttribute('aria-hidden', 'true');
    document.body.classList.remove('overflow-hidden');
  };

  const trackClinicQuoteOpen = () => {
    const service = selectedClinicQuoteService();
    const clinicId = clinicQuoteForm?.getAttribute('data-clinic-id') || '';
    const virtualPath = `${window.location.pathname}#preventivo/${service.slug || 'visita-semplice'}`;
    if (typeof (window as any).gtag === 'function') {
      (window as any).gtag('event', 'page_view', {
        page_title: `Preventivo ${service.name}`,
        page_path: virtualPath,
        page_location: `${window.location.origin}${virtualPath}`,
      });
      (window as any).gtag('event', 'quote_request_open', {
        service_slug: service.slug,
        service_name: service.name,
        clinic_id: clinicId,
        trigger: 'clinic-sticky-mobile',
        page_path: virtualPath,
      });
    }
    fetch('/api/quote-funnel-event', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      credentials: 'same-origin',
      body: JSON.stringify({
        event_type: 'quote_request_open',
        service_slug: service.slug || 'visita-semplice',
        service_name: service.name,
        location_label: clinicQuoteForm?.getAttribute('data-location-label') || '',
        page_path: virtualPath,
        selected_clinic_count: 1,
        selected_clinic_id: clinicId,
        trigger: 'clinic-sticky-mobile',
        page_location: window.location.href,
      }),
    }).catch(() => null);
  };

  const openClinicQuoteModal = () => {
    if (!clinicQuoteModal) return;
    updateClinicQuoteMessage();
    clinicQuoteModal.classList.remove('hidden');
    clinicQuoteModal.setAttribute('aria-hidden', 'false');
    document.body.classList.add('overflow-hidden');
    trackClinicQuoteOpen();
    clinicQuoteServiceSelect?.focus();
  };

  const closeClinicQuoteModal = () => {
    if (!clinicQuoteModal) return;
    clinicQuoteModal.classList.add('hidden');
    clinicQuoteModal.setAttribute('aria-hidden', 'true');
    document.body.classList.remove('overflow-hidden');
  };

  document.querySelectorAll<HTMLElement>('[data-contact-open]').forEach((button) => {
    button.addEventListener('click', openContactModal);
  });

  document.querySelectorAll<HTMLElement>('[data-contact-close]').forEach((button) => {
    button.addEventListener('click', closeContactModal);
  });

  document.querySelectorAll<HTMLElement>('[data-clinic-quote-open]').forEach((button) => {
    button.addEventListener('click', openClinicQuoteModal);
  });

  document.querySelectorAll<HTMLElement>('[data-clinic-quote-close]').forEach((button) => {
    button.addEventListener('click', closeClinicQuoteModal);
  });

  clinicQuoteServiceSelect?.addEventListener('change', () => {
    updateClinicQuoteMessage();
    trackClinicQuoteOpen();
  });

  document.querySelectorAll<HTMLElement>('[data-favorite-modal-close]').forEach((button) => {
    button.addEventListener('click', closeFavoriteLoginModal);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeContactModal();
    if (event.key === 'Escape') closeClinicQuoteModal();
    if (event.key === 'Escape') closeFavoriteLoginModal();
  });

  if (favoriteButton) {
    const clinicId = favoriteButton.dataset.clinicId || '';
    fetch('/api/pet-lover', { credentials: 'same-origin' })
      .then((response) => response.ok ? response.json() : null)
      .then((payload) => {
        const favorites = payload?.data?.favorite_clinics || [];
        setFavoriteUi(favorites.some((clinic: any) => String(clinic.id) === clinicId));
      })
      .catch(() => null);

    favoriteButton.addEventListener('click', async () => {
      favoriteButton.setAttribute('disabled', 'true');
      try {
        const response = await fetch('/api/pet-lover', {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'toggle_favorite_clinic', clinic_id: clinicId }),
        });
        const payload = await response.json().catch(() => ({}));
        if (response.status === 401) {
          openFavoriteLoginModal();
          return;
        }
        if (!response.ok || payload.success === false) throw new Error(payload.error || 'Preferito non salvato.');
        setFavoriteUi(Boolean(payload.favorited));
        showFavoriteFeedback(payload.favorited ? 'Aggiunto ai tuoi veterinari preferiti.' : 'Rimosso dai preferiti.');
      } catch (error: any) {
        showFavoriteFeedback(error?.message || 'Operazione non riuscita.');
      } finally {
        favoriteButton.removeAttribute('disabled');
      }
    });
  }

  if (contactForm) {
    fetch('/api/local-auth?action=session', { credentials: 'same-origin' })
      .then((response) => response.ok ? response.json() : null)
      .then((payload) => {
        const sessionUser = payload?.session?.user;
        if (!sessionUser) return;
        const metadata = sessionUser.user_metadata || {};
        const nameInput = contactForm.querySelector<HTMLInputElement>('input[name="name"]');
        const emailInput = contactForm.querySelector<HTMLInputElement>('input[name="email"]');
        const phoneInput = contactForm.querySelector<HTMLInputElement>('input[name="phone"]');
        if (nameInput && !nameInput.value) nameInput.value = metadata.full_name || '';
        if (emailInput && !emailInput.value) emailInput.value = sessionUser.email || '';
        if (phoneInput && !phoneInput.value) phoneInput.value = metadata.phone || '';

        return fetch('/api/pet-lover', { credentials: 'same-origin' });
      })
      .then((response) => response && response.ok ? response.json() : null)
      .then((payload) => {
        const pets = payload?.data?.pets || [];
        if (!pets.length || !contactPetPanel || !contactPetSelect) return;
        pets.forEach((pet: any) => {
          const option = document.createElement('option');
          option.value = pet.id;
          option.textContent = `${pet.name} (${pet.species || 'animale'})`;
          contactPetSelect.appendChild(option);
        });
        contactPetPanel.classList.remove('hidden');
      })
      .catch(() => null);

    contactForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      const submitButton = contactForm.querySelector<HTMLButtonElement>('button[type="submit"]');
      const formData = new FormData(contactForm);

      submitButton?.setAttribute('disabled', 'true');
      showContactFeedback('Invio richiesta in corso...', 'success');

      try {
        let finalMessage = String(formData.get('message') || '');
        const selectedPetId = String(formData.get('pet_id') || '');
        if (selectedPetId) {
          const shareResponse = await fetch('/api/pet-lover', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'same-origin',
            body: JSON.stringify({ action: 'create_share_link', pet_id: selectedPetId, scopes: ['base', 'health'] }),
          });
          const shareResult = await shareResponse.json().catch(() => ({}));
          if (shareResponse.ok && shareResult?.token) {
            finalMessage = `${finalMessage}\n\nScheda animale condivisa: ${window.location.origin}/pet-share/${shareResult.token}`;
          }
        }

        const response = await fetch('/api/contact-request', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify({
            clinic_id: formData.get('clinic_id'),
            clinic_name: formData.get('clinic_name'),
            name: formData.get('name'),
            email: formData.get('email'),
            phone: formData.get('phone'),
            message: finalMessage,
            captcha_answer: formData.get('captcha_answer'),
            captcha_token: formData.get('captcha_token'),
            privacy_accepted: formData.get('privacy_accepted') === 'true',
            company: formData.get('company'),
          }),
        });
        const result = await response.json().catch(() => ({}));
        if (!response.ok || !result.success) throw new Error(result.error || 'Richiesta non inviata.');
        if (typeof (window as any).gtag === 'function') {
          (window as any).gtag('event', 'contact_request_submit', {
            request_id: result.request_id || '',
            clinic_id: formData.get('clinic_id') || '',
            clinic_name: formData.get('clinic_name') || '',
            page_path: window.location.pathname,
          });
        }
        showContactFeedback('Richiesta inviata. La struttura potra ricontattarti direttamente.', 'success');
        contactForm.reset();
      } catch (error: any) {
        showContactFeedback(error?.message || 'Errore durante l invio della richiesta.', 'error');
      } finally {
        submitButton?.removeAttribute('disabled');
      }
    });
  }

  if (clinicQuoteForm) {
    fetch('/api/local-auth?action=session', { credentials: 'same-origin' })
      .then((response) => response.ok ? response.json() : null)
      .then((payload) => {
        const sessionUser = payload?.session?.user;
        if (!sessionUser) return;
        const metadata = sessionUser.user_metadata || {};
        const nameInput = clinicQuoteForm.querySelector<HTMLInputElement>('input[name="name"]');
        const emailInput = clinicQuoteForm.querySelector<HTMLInputElement>('input[name="email"]');
        const phoneInput = clinicQuoteForm.querySelector<HTMLInputElement>('input[name="phone"]');
        if (nameInput && !nameInput.value) nameInput.value = metadata.full_name || '';
        if (emailInput && !emailInput.value) emailInput.value = sessionUser.email || '';
        if (phoneInput && !phoneInput.value) phoneInput.value = metadata.phone || '';
      })
      .catch(() => null);

    clinicQuoteForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      const submitButton = clinicQuoteForm.querySelector<HTMLButtonElement>('button[type="submit"]');
      const formData = new FormData(clinicQuoteForm);
      const service = selectedClinicQuoteService();
      const clinicId = clinicQuoteForm.getAttribute('data-clinic-id') || '';
      const clinicName = clinicQuoteForm.getAttribute('data-clinic-name') || '';
      const locationLabel = clinicQuoteForm.getAttribute('data-location-label') || '';
      const sourcePath = clinicQuoteForm.getAttribute('data-source-path') || window.location.pathname;

      submitButton?.setAttribute('disabled', 'true');
      showClinicQuoteFeedback('Invio preventivo in corso...', 'success');

      try {
        const email = String(formData.get('email') || '').trim();
        if (!email.includes('@')) {
          clinicQuoteForm.querySelector<HTMLInputElement>('input[name="email"]')?.focus();
          throw new Error('Inserisci una email valida.');
        }

        const response = await fetch('/api/quote-request', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify({
            service_slug: service.slug,
            service_name: service.name,
            location_label: locationLabel,
            average_price: service.averagePrice || null,
            source_path: sourcePath,
            name: formData.get('name'),
            email,
            phone: formData.get('phone'),
            message: formData.get('message'),
            captcha_answer: formData.get('captcha_answer'),
            captcha_token: formData.get('captcha_token'),
            privacy_accepted: formData.get('privacy_accepted') === 'true',
            company: formData.get('company'),
            clinic_ids: [clinicId],
            clinic_matches: [{ id: clinicId, result_type: service.source === 'declared' ? 'declared' : 'profile_request', result_label: clinicName }],
          }),
        });
        const result = await response.json().catch(() => ({}));
        if (!response.ok || !result.success) throw new Error(result.error || 'Preventivo non inviato.');
        if (typeof (window as any).gtag === 'function') {
          (window as any).gtag('event', 'quote_request_submit', {
            request_id: result.request_id || '',
            service_slug: service.slug,
            service_name: service.name,
            clinic_id: clinicId,
            clinic_name: clinicName,
            source: 'clinic_profile_mobile',
            page_path: window.location.pathname,
          });
        }
        showClinicQuoteFeedback(result.duplicate ? 'Richiesta gia inviata pochi minuti fa: non l abbiamo reinviata.' : 'Richiesta inviata. La struttura potra risponderti direttamente.', 'success');
        clinicQuoteForm.reset();
        updateClinicQuoteMessage();
      } catch (error: any) {
        showClinicQuoteFeedback(error?.message || 'Errore durante l invio del preventivo.', 'error');
      } finally {
        submitButton?.removeAttribute('disabled');
      }
    });
  }
</script>

<style>
  .vet-detail-hero {
    height: 12rem;
    overflow: hidden;
  }

  .vet-detail-hero img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .vet-detail-hero-overlay {
    background:
      linear-gradient(180deg, rgba(0, 0, 0, 0.04) 0%, rgba(0, 0, 0, 0.10) 100%);
  }

  .vet-detail-hero-title {
    text-shadow: 0 2px 14px rgba(0, 0, 0, 0.55);
  }

  .vet-detail-status {
    display: flex;
    max-width: min(100%, 46rem);
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    line-height: 1.35;
  }

  .vet-detail-map {
    height: 20rem;
    filter: saturate(1.28) contrast(1.08);
  }

  .vet-detail-map-wrap {
    overflow: hidden;
    background: #eef2f7;
  }

  .vet-mobile-contact-bar {
    position: fixed;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 60;
    border-top: 1px solid rgba(226, 232, 240, 0.95);
    background: rgba(255, 255, 255, 0.96);
    box-shadow: 0 -10px 30px rgba(15, 23, 42, 0.16);
    backdrop-filter: blur(14px);
    padding-bottom: env(safe-area-inset-bottom);
  }

  @media (min-width: 640px) {
    .vet-detail-hero {
      height: 18rem;
    }
  }

  @media (min-width: 1024px) {
    .vet-detail-hero {
      height: 20rem;
    }

    .vet-detail-map {
      height: 22rem;
    }
  }
</style>
