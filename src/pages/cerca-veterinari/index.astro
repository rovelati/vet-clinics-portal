---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CercaVeterinariApp from '@/components/react/CercaVeterinariApp.jsx';
import { siteConfig } from '@/config/site';
import { searchClinics } from '@/lib/clinics';
import { slugifyLocation } from '@/lib/seo-urls';
import { supabasePublicServer } from '@/lib/supabase';

function cleanText(value: unknown) {
  return typeof value === 'string' ? value.replace(/"/g, '').trim() : '';
}

function slugify(value: unknown) {
  return cleanText(value)
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/[^a-z0-9\s-]/g, '')
    .trim()
    .replace(/\s+/g, '-')
    .replace(/-+/g, '-');
}

function isH24Intent(value: unknown) {
  const normalized = ` ${slugify(value).replace(/-/g, ' ')} `;
  return /\b(h24|24h|24 ore|aperto 24|urgenza|emergenza|pronto soccorso)\b/.test(normalized)
    || /\bveterinari? h24\b/.test(normalized)
    || /\bcliniche? h24\b/.test(normalized);
}

async function loadServiceSuggestions() {
  if (!supabasePublicServer) return [];
  const { data, error } = await supabasePublicServer
    .from('services_taxonomy')
    .select('name, allow_price')
    .neq('allow_price', false)
    .limit(500);

  if (error) {
    console.error('Errore caricamento prestazioni ricerca:', error.message);
    return [];
  }

  return (data ?? [])
    .map((service: any) => ({ name: cleanText(service.name), slug: slugify(service.name) }))
    .filter((service) => service.name && service.slug);
}

async function resolveLocationForH24(location: string) {
  const locationSlug = slugifyLocation(location);
  if (!supabasePublicServer || !locationSlug) return { citySlug: locationSlug, provinceSlug: '' };

  const cityName = locationSlug.split('-').map((word) => word.charAt(0).toUpperCase() + word.slice(1)).join(' ');
  const { data, error } = await supabasePublicServer
    .from('clinics')
    .select('raw_import')
    .eq('status', 'pubblicata')
    .not('slug', 'is', null)
    .filter('raw_import->>city', 'ilike', cityName)
    .limit(1);

  if (error) {
    console.error('Errore risoluzione localita H24:', error.message);
    return { citySlug: locationSlug, provinceSlug: '' };
  }

  const province = cleanText(data?.[0]?.raw_import?.province).toLowerCase();
  return { citySlug: locationSlug, provinceSlug: province };
}

const query = Astro.url.searchParams.get('query')?.trim() ?? '';
const location = Astro.url.searchParams.get('location')?.trim() ?? '';
const hasSearch = Boolean(query || location);
const serviceSuggestions = await loadServiceSuggestions();
const matchedService = query
  ? serviceSuggestions.find((service) => service.slug === slugify(query))
  : null;

if (query && isH24Intent(query)) {
  const locationInfo = await resolveLocationForH24(location);
  const target = locationInfo.citySlug
    ? locationInfo.provinceSlug
      ? `/veterinari-h24/${locationInfo.provinceSlug}/${locationInfo.citySlug}`
      : `/veterinari-h24/${locationInfo.citySlug}`
    : '/veterinari-h24';
  return Astro.redirect(target, 302);
}

if (matchedService) {
  const locationSlug = slugifyLocation(location);
  const target = locationSlug
    ? `/quanto-costa/${locationSlug}/${matchedService.slug}/cliniche`
    : `/quanto-costa/${matchedService.slug}/cliniche`;
  return Astro.redirect(target, 302);
}

const title = hasSearch
  ? `Cerca veterinari${query ? ` per ${query}` : ''}${location ? ` a ${location}` : ''} | ${siteConfig.name}`
  : `Cerca veterinari e cliniche veterinarie | ${siteConfig.name}`;

const clinics = await searchClinics({ query, location, limit: location ? 120 : 24 });
---

<BaseLayout
  title={title}
  description="Cerca veterinari e cliniche veterinarie in Italia per localita, servizi, orari e disponibilita."
  canonical={`${siteConfig.url}/cerca-veterinari`}
>
  <CercaVeterinariApp
    client:load
    initialClinics={clinics}
    initialQuery={query}
    initialLocation={location}
    serviceSuggestions={serviceSuggestions}
  />
</BaseLayout>
