---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { siteConfig } from '@/config/site';

const token = Astro.params.token || '';
---

<BaseLayout
  title={`Scheda animale condivisa | ${siteConfig.name}`}
  description="Scheda animale condivisa tramite link sicuro."
  canonical={`${siteConfig.url}/pet-share/${token}`}
  noindex={true}
>
  <main class="mx-auto max-w-3xl px-4 py-8 sm:px-6 lg:px-8">
    <div id="pet-share-view" data-token={token} class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
      <p class="text-sm text-slate-500">Caricamento scheda...</p>
    </div>
  </main>
  <script>
    const mount = document.getElementById('pet-share-view');
    const tokenValue = mount?.getAttribute('data-token') || '';
    function line(label, value) {
      return value ? `<div class="rounded-md border border-slate-100 bg-slate-50 p-3"><dt class="text-xs font-semibold uppercase text-slate-500">${label}</dt><dd class="mt-1 text-sm text-slate-900">${String(value).replace(/[<>]/g, '')}</dd></div>` : '';
    }
    fetch(`/api/pet-share/${encodeURIComponent(tokenValue)}`)
      .then((response) => response.json())
      .then((payload) => {
        if (!mount) return;
        if (!payload.success) {
          mount.innerHTML = `<h1 class="text-xl font-semibold text-slate-950">Link non disponibile</h1><p class="mt-2 text-slate-600">${payload.error || 'La condivisione e scaduta o revocata.'}</p>`;
          return;
        }
        const pet = payload.data;
        const scopes = pet.scopes || [];
        mount.innerHTML = `
          <div class="flex items-start gap-4">
            <div class="grid h-16 w-16 shrink-0 place-items-center rounded-full bg-emerald-100 text-3xl">${pet.photo_url ? `<img src="${pet.photo_url}" alt="" class="h-16 w-16 rounded-full object-cover">` : '🐾'}</div>
            <div>
              <p class="text-sm font-semibold uppercase text-emerald-700">Scheda condivisa</p>
              <h1 class="text-2xl font-bold text-slate-950">${pet.name}</h1>
              <p class="mt-1 text-sm text-slate-500">${pet.species || ''}${pet.breed ? ` · ${pet.breed}` : ''}</p>
            </div>
          </div>
          <dl class="mt-6 grid gap-3 sm:grid-cols-2">
            ${line('Sesso', pet.sex)}
            ${line('Data nascita', pet.birth_date)}
            ${line('Peso', pet.weight_kg ? `${pet.weight_kg} kg` : '')}
            ${line('Microchip', pet.microchip)}
            ${scopes.includes('health') ? line('Allergie', pet.allergies) : ''}
            ${scopes.includes('health') ? line('Patologie', pet.conditions) : ''}
            ${scopes.includes('health') ? line('Farmaci', pet.medications) : ''}
            ${scopes.includes('health') ? line('Alimentazione', pet.nutrition_notes) : ''}
            ${scopes.includes('health') ? line('Comportamento', pet.behavior_notes) : ''}
          </dl>
          <div class="mt-6 rounded-md border border-slate-200 bg-slate-50 p-4 text-sm text-slate-600">
            Proprietario: <strong>${pet.owner_name || pet.owner_email}</strong>${pet.owner_phone ? ` · ${pet.owner_phone}` : ''}
          </div>`;
      })
      .catch(() => {
        if (mount) mount.innerHTML = '<p class="text-red-700">Impossibile caricare la scheda condivisa.</p>';
      });
  </script>
</BaseLayout>
